  "acceptanceCriteria": [
    {
      "id": "AC01",
      "scenario": "HTTP/HTTPS first load",
      "expected": "Data and controls ready before optional map/chart; citymeter:ready dismisses launch overlay",
      "verificationType": "browser",
      "result": "see VERIFICATION.md"
    },
    {
      "id": "AC02",
      "scenario": "Local file entry",
      "expected": "Fixed public route preserves query/hash; do not bypass origin protections",
      "verificationType": "manual-browser",
      "result": "see VERIFICATION.md"
    },
    {
      "id": "AC03",
      "scenario": "Core data/module failure",
      "expected": "Actionable retry and public link; never blank shell or endless spinner",
      "verificationType": "fault-injection",
      "result": "see VERIFICATION.md"
    },
    {
      "id": "AC04",
      "scenario": "Malformed optional data",
      "expected": "Counts, filters and table remain usable; invalid geometry never enters spatial calculation",
      "verificationType": "fault-injection",
      "result": "see VERIFICATION.md"
    },
    {
      "id": "AC05",
      "scenario": "Map/chart timeout and retry",
      "expected": "Core data survives; retries do not duplicate script/map/overlay",
      "verificationType": "fault-injection",
      "result": "see VERIFICATION.md"
    },
    {
      "id": "AC06",
      "scenario": "Aha, filters and shared URL state",
      "expected": "Same source rows drive views; restore query and clear area focus correctly",
      "verificationType": "browser-and-unit",
      "result": "see VERIFICATION.md"
    },
    {
      "id": "AC07",
      "scenario": "Co-located source points",
      "expected": "Separate ID per pin; bounded display offsets; source coordinates unchanged",
      "verificationType": "unit-and-browser",
      "result": "see VERIFICATION.md"
    },
    {
      "id": "AC08",
      "scenario": "Logo density",
      "expected": "No more than 250 collision-free labels; distinct brands prioritized; points remain",
      "verificationType": "unit-and-browser",
      "result": "see VERIFICATION.md"
    },
    {
      "id": "AC09",
      "scenario": "Responsive light/dark",
      "expected": "48px header, full map, readable popup, no horizontal page overflow at 390px and desktop",
      "verificationType": "browser",
      "result": "see VERIFICATION.md"
    },
    {
      "id": "AC10",
      "scenario": "Keyboard and reduced motion",
      "expected": "Visible focus, usable pins/chart controls/help/tabs; Escape returns focus; motion respected",
      "verificationType": "manual-browser",
      "result": "see VERIFICATION.md"
    },
    {
      "id": "AC11",
      "scenario": "Presentation and data truth",
      "expected": "No generic caveat/research/CSV UI; retain real closure status/date/source/units",
      "verificationType": "source-and-browser",
      "result": "see VERIFICATION.md"
    },
    {
      "id": "AC12",
      "scenario": "Release and handoff",
      "expected": "Source commit, public bytes, hashes and bundle match; no secrets/private source URLs",
      "verificationType": "release-attestation",
      "result": "see VERIFICATION.md"
    }
  ],
  "developerWorkflow": [
    "Read AGENTS.md then handoff/README.md and paired human/machine briefs",
    "Run baseline tests before changes",
    "Change one bounded task at a time and preserve invariant IDs",
    "Validate calculations with real dataset fixtures",
    "Inspect rendered Thai/English at desktop and narrow widths in both themes",
    "Publish only authorized changes and verify provider terminal status plus live file hashes",
    "Regenerate handoff manifest from final source bytes; do not hand-edit hashes"
  ],
